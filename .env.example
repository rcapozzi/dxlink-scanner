# Tastytrade OAuth2 credentials
# client_id is your Tastytrade USERNAME (not a separate app credential)
# client_secret is the secret generated when you create an OAuth app
# refresh_token is generated by creating a Grant in your OAuth app
TASTY_CLIENT_ID=
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=

# Set to true to use sandbox (delayed data)
TASTY_SANDBOX=false

# Webhook URL for alerts (optional)
WEBHOOK_URL=
